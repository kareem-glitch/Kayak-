{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "air.band",
  "version": "0.6.1",
  "identifier": "band.air.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "resources": {
      "plugin/": "plugin/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwNjMyOTIwRDgwOEY0MDkKUldRSjlBallJQ2xqOEN6RURvZW1nL2U5RmVBM3ZrWkNhak9Tbzd4QnJJZDJmTXQ5TDFJaDg0c1cK",
      "endpoints": [
        "https://air.band/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
