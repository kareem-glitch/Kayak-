# Copy to .env on the VM. Never commit .env.
# Same value as HUB_SECRET in the Vercel project (openssl rand -hex 32).
HUB_SECRET=
# Public hostname of the hub; the TLS certificate must be for this name.
HUB_DOMAIN=hub.example.com
HUB_PORT=4464
UDP_BASE_PORT=61002
SAMPLE_RATE=48000
# Hub audio period in frames. 128 matches the browser AudioWorklet block; 64 halves hub latency, uses more CPU.
BUFFER_SIZE=128
JACK_REALTIME=1
ICE_SERVERS=stun:stun.l.google.com:19302
